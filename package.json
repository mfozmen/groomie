{
  "name": "groomie",
  "version": "1.1.1",
  "description": "Groom a messy single-feature idea — a Jira issue, Confluence page, URL, or file — into a clean epic / user-story / technical-task breakdown, with tasks blocking stories. Outputs markdown.",
  "type": "module",
  "main": "./opencode/plugin.js",
  "exports": {
    ".": "./opencode/plugin.js"
  },
  "files": [
    "opencode/",
    "skills/",
    "commands/",
    "agents/",
    ".claude-plugin/",
    "docs/groomie.config.example.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "license": "MIT",
  "author": "Mehmet Fahri Özmen",
  "homepage": "https://github.com/mfozmen/groomie",
  "repository": {
    "type": "git",
    "url": "https://github.com/mfozmen/groomie.git"
  },
  "bugs": {
    "url": "https://github.com/mfozmen/groomie/issues"
  },
  "keywords": [
    "claude-code",
    "opencode",
    "jira",
    "confluence",
    "agile",
    "user-stories",
    "epics",
    "backlog",
    "grooming"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "release": "release-it",
    "prepublishOnly": "npm test",
    "test": "node --test opencode/plugin.test.mjs",
    "test:opencode": "node --test opencode/plugin.test.mjs"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.0",
    "release-it": "^19.0.0"
  }
}
